---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const contact = siteConfig.contact;
const action = contact.action.trim();
const isEnabled = contact.enabled;
/* No endpoint configured: keep the form usable and confirm the submit locally
   rather than posting the page to nowhere. With an endpoint configured the
   form is submitted via fetch so the page never navigates away to FormSubmit. */
const successMessage = `Thanks — your message was sent. ${contact.responseTime}`.trim();
const errorMessage = siteConfig.email
  ? `Something went wrong. Please try again, or write directly to ${siteConfig.email}.`
  : "Something went wrong. Please try again.";
/* Official FormSubmit AJAX endpoint: same address with an /ajax/ prefix.
   It returns JSON ({ success: "true" }) instead of the Thank You page. */
const ajaxAction = action.includes("/ajax/")
  ? action
  : action.replace("formsubmit.co/", "formsubmit.co/ajax/");
---

<BaseLayout title="Contact" description={`Get in touch with ${siteConfig.name}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Contact</p>
        <h1 class="pagehead-title">Get in touch</h1>
        <p class="pagehead-description">
          Corrections, questions, and requests all land in the same inbox. {contact.responseTime}
        </p>
        {
          siteConfig.email && (
            <p class="mt-4 text-sm text-muted-foreground">
              Prefer email? Write to <a href={`mailto:${siteConfig.email}`} class="text-accent underline underline-offset-2">{siteConfig.email}</a>.
            </p>
          )
        }
      </header>

      <form
        class="grid gap-5"
        action={action || undefined}
        method={contact.method}
        data-contact-form={isEnabled ? "" : undefined}
        data-ajax-url={ajaxAction || undefined}
        data-demo-message="Thanks. This demo form is not connected to an endpoint yet, so nothing was sent."
        data-success-message={successMessage}
        data-error-message={errorMessage}
      >
        <input type="hidden" name="_subject" value="New contact message from Monograph" />
        {/* Honeypot for spam bots. Real users never see or fill this. */}
        <input
          type="text"
          name="_honey"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-name">Name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required disabled={!isEnabled} class="field" />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-email">Email</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required disabled={!isEnabled} class="field" />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="7" required disabled={!isEnabled} class="field resize-y"></textarea>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" disabled={!isEnabled} class="btn btn-solid">
            {isEnabled ? "Send message" : "Form unavailable"}
          </button>
          <p class="contact-status text-sm leading-relaxed text-muted-foreground" role="status" aria-live="polite" data-contact-status></p>
        </div>

        {
          !isEnabled && (
            <p class="text-sm leading-relaxed text-muted-foreground">
              {/* This form is disabled until a form endpoint is configured in <code>siteConfig.contact</code>. */}
              This form is currently unavailable. Please, reach out via email.
            </p>
          )
        }
      </form>
    </div>
  </main>
  <SiteFooter />

  {
    isEnabled && (
      <script is:inline>
        document.querySelectorAll("[data-contact-form]").forEach((form) => {
          let fadeTimer;
          const fadeStatusLater = (status) => {
            clearTimeout(fadeTimer);
            fadeTimer = setTimeout(() => {
              status.classList.add("is-fading");
              fadeTimer = setTimeout(() => {
                status.textContent = "";
                status.classList.remove("is-fading");
              }, 400);
            }, 4000);
          };
          form.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (form.dataset.sending === "true") return;
            const status = form.querySelector("[data-contact-status]");
            const submit = form.querySelector('button[type="submit"]');
            const endpoint = form.getAttribute("action");
            const originalLabel = submit ? submit.textContent : "";
            clearTimeout(fadeTimer);
            if (status) status.classList.remove("is-fading");
            // Demo form (no endpoint): confirm locally, send nothing.
            if (!endpoint) {
              if (status) {
                status.textContent = form.dataset.demoMessage || "Thanks.";
                fadeStatusLater(status);
              }
              form.reset();
              return;
            }
            form.dataset.sending = "true";
            if (submit) {
              submit.disabled = true;
              submit.textContent = "Sending…";
            }
            if (status) {
              status.textContent = "Sending…";
            }
            try {
              const ajaxUrl = form.dataset.ajaxUrl || endpoint;
              const formData = new FormData(form);
              const payload = Object.fromEntries(formData.entries());
              const response = await fetch(ajaxUrl, {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Accept: "application/json",
                },
                body: JSON.stringify(payload),
              });
              let data = null;
              try {
                data = await response.json();
              } catch (parseError) {
                throw new Error("Submit failed");
              }
              // FormSubmit returns { success: "true" } (string) on success,
              // e.g. { success: "false", message: "...activation..." } otherwise.
              if (!response.ok || data.success !== "true") throw new Error(data.message || "Submit failed");
              if (status) {
                status.textContent = form.dataset.successMessage || "Thanks — your message was sent.";
                fadeStatusLater(status);
              }
              form.reset();
            } catch (error) {
              if (status) {
                status.textContent = form.dataset.errorMessage || "Something went wrong. Please try again.";
              }
            } finally {
              delete form.dataset.sending;
              if (submit) {
                submit.disabled = false;
                if (originalLabel) submit.textContent = originalLabel;
              }
            }
          });
        });
      </script>
    )
  }

  <style>
    .contact-status:empty {
      display: none;
    }
    .contact-status {
      transition: opacity 0.4s ease;
    }
    .contact-status.is-fading {
      opacity: 0;
    }
  </style>
</BaseLayout>
